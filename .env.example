# Configuration reference. The app reads these from ENVIRONMENT VARIABLES
# (Streamlit does not load .env files by itself). For example:
#   PowerShell:  $env:OPENAI_API_KEY = "sk-..."
#   bash/zsh:    export OPENAI_API_KEY="sk-..."
# Alternatively put only the key in a local key_openai.txt file (git-ignored).

# Required
OPENAI_API_KEY=

# Optional (defaults shown)
ASSISTANT_MODEL=gpt-4.1-mini
EVAL_MODEL=gpt-4o-mini
INJECTION_MODEL=gpt-4o-mini
MODERATION_MODEL=omni-moderation-latest
MAX_TURNS_TO_KEEP=10
EVAL_LOG_PATH=logs/eval_logs.jsonl
